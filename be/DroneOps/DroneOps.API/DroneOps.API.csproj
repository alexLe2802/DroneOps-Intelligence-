<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FirebaseAdmin" Version="3.6.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.31" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DroneOps.Application\DroneOps.Application.csproj" />
		<ProjectReference Include="..\DroneOps.Domain\DroneOps.Domain.csproj" />
		<ProjectReference Include="..\DroneOps.Persistence\DroneOps.Persistence.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="secrets/**" />
		<None Remove="secrets/**" />
		<Content Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="../../../database/certificates/prod-ca-2021.crt" Link="database/certificates/prod-ca-2021.crt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="../../../database/migrations/001_auth.sql" Link="Migrations/001_auth.sql" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="../../../database/migrations/004_first_login.sql" Link="Migrations/004_first_login.sql" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="../../../database/migrations/003_canonical_roles.sql" Link="Migrations/003_canonical_roles.sql" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="../../../database/migrations/002_ai_assessments.sql" Link="Migrations/002_ai_assessments.sql" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Tự động dừng tiến trình DroneOps.API đang chạy trước khi build để tránh lỗi khóa file (MSB3027/MSB3021) trên Windows -->
	<Target Name="KillRunningApiBeforeBuild" BeforeTargets="BeforeBuild;BeforeRebuild" Condition="'$(OS)' == 'Windows_NT'">
		<Exec Command="taskkill /f /im DroneOps.API.exe 2&gt;nul || exit 0" IgnoreExitCode="true" />
	</Target>

</Project>
