# Copy to .env.local and fill values from Firebase Console > Project settings.
# Server-only; browser traffic uses the same-origin /api proxy.
API_BASE_URL=http://localhost:5159
# Firebase WEB configuration is necessarily public in the browser bundle.
# NEVER put a private key / service account in NEXT_PUBLIC_*.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
